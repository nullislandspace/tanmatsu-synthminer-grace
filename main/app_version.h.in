#pragma once
// Generated by CMakeLists.txt from main/app_version.h.in on every build.
// The debug console reports these so the test runner can refuse to test
// a badge that is running some other build (tools/testrun.py).
#define APP_GIT_HASH   "@APP_GIT_HASH@"
#define APP_BUILD_TIME "@APP_BUILD_TIME@"

// The release, straight out of metadata/metadata.json -- the file the
// app repository and every installed badge already go by. Empty if that
// file has no version, in which case the title simply shows nothing.
#define APP_VERSION    "@APP_VERSION@"
